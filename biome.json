{
    "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
    "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
    },
    "files": {
      "includes": ["**", "!**/dist"]
    },
    "formatter": {
      "enabled": true,
      "lineWidth": 80,
      "indentStyle": "space",
      "indentWidth": 2
    },
    "linter": {
      "enabled": true,
      "rules": {
        "preset": "recommended",
        "a11y": {
          "noStaticElementInteractions": "off",
          "useKeyWithClickEvents": "off"
        }
      }
    },
  
    "javascript": {
      "formatter": {
        "quoteStyle": "double"
      }
    },
    "assist": {
      "enabled": true,
      "actions": {
        "source": {
          "organizeImports": "on"
        }
      }
    }
  }
  